
 header {
            background-color:red; height: 100px;
            padding: 10px 40px;
            margin-bottom: 50px;
            border-radius: 40px;
            box-shadow: 20px 20px 50px gray;
            
           
        }
            nav {
        
             padding: 10px 40px;
             }
             nav ul {
                margin: 0px; 
                padding: 0px;
                list-style: none;
             }
             nav #menu li {
                display: inline-block;
                
             }
             nav #menu ul li{
               display: inherit;
               
             }
             nav #menu ul {
                position: absolute;
                display: block;
                background-color: red;
                left: -999px;
                text-align: left;
                z-index: 1000;
              
             }
             nav #menu li:hover ul {
                left: auto;
     
             }

        main {
            background-color: lightgray;
             padding: 10px 40px;
            margin-bottom: 50px;
            border-radius: 40px;
            box-shadow: 20px 20px 50px gray;

        }
        footer {
            background-color: yellow;
             padding: 10px 40px;
            margin-bottom: 50px;
            border-radius: 40px;
            box-shadow: 20px 20px 50px gray;

        }
        body {
            background-color: blueviolet;
        }
        p {
            color: white;
            font-size: 20px;
            font-family: New Times Roman, sans-serif;
        }
        h2 {
            color: rgb(128, 0, 21);
        }
        <!-- le css permet de styliser les éléments HTML pour améliorer l'apparence visuelle d'une page web
        .grace à cette fonctionalité, on peut créer un fichier css à part et appliquer l'ensemble des styles sur un 
        fichier html, en fauisant simplement réfernece au fichier css avec cette balise <link rel="stylesheet" href="fichier css en question">
        et aussi ç apermet de ne pas avoir à répéter les styles dans chaque page html, et avoir beaucoup de ligne 
        dans un fichier html -->
# partie2:
 .header {background-color:#0000ff; 
        justify-content: space-between;
        align-items: center;
        padding: 10px 50px;
 
    }
    .logo {
        width: 100px;
    }
    body {
        margin:0;
    }
    .logo{
          width: 100px;
    }
    .header-link a{
        color:white; 
    }
    .header-link a:hover {
        color:white;
        padding: 5 15px;
        text-decoration: none;
        }
    .header-link a:hover {
        background-color:rgb(255, 0, 98);
        border-radius: 15px;
        
        }
    .landing-page {
        background-color: #0000ff;
        justify-content: space-between;
        padding: 10 50px;
        display: flex;
        }

 
